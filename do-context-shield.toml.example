# Reference: docs/configuration.md
# Plugin selection. All plugins have compiled-in defaults; a value here
# overrides that default and is itself overridden by the matching CLI flag.
[plugins]
detector = "regex"                  # regex | gliner2 | hybrid | process
policy = "default"                  # default | matrix | process
transformer = "pseudonymize"        # pseudonymize | generalize | mask | process
# judge = "heuristics"             # heuristics | process (optional)
# tools = "sanitize,inspect"       # mcp-stdio only: sanitize | restore | inspect | forget | all
# model_dir = "path/to/gliner2"    # GLiNER2 ONNX export directory
# detector_command = "my-detector"  # process plugin command
# policy_command = "my-policy"
# transformer_command = "my-transformer"
# judge_command = "my-judge"

[vault]
# vault = "memory"                 # memory | json | process
# vault_file = "vault.json"        # required with vault = "json"
# vault_command = "my-vault"       # process plugin command
# vault_ttl_seconds = 3600         # memory or JSON vault mapping lifetime
# vault_key_file = "vault.key"     # 64-hex key file that encrypts the JSON vault at rest

[audit]
# audit_file = "audit.jsonl"         # private local append-only JSONL audit destination

# Default enforcement context for `sanitize`. CLI flags override per call.
[context]
# recipient = "external"           # local | trusted | external | unknown
# data_category = "personal"       # non_personal | personal | special_category
# purpose = "code assistance"
# jurisdiction = "DE"

[process]
# timeout_ms = 30000               # per-plugin response timeout

# Opt-in `policy = "matrix"` configuration: jurisdiction adequacy and
# purpose-conditional rules. Requires `plugins.policy = "matrix"` (or
# `--policy matrix`); a `[policy_matrix]` section under another policy is
# rejected at startup. See docs/configuration.md.
# [policy_matrix]
# origin = "DE"                    # ISO 3166-1 alpha-2 code of the operator
# adequate_jurisdictions = ["FR", "GB"]
# enforce_adequacy_for_trusted = true
# [[policy_matrix.purpose_rules]]
# purpose = "internal_analytics"
# recipients = ["local", "trusted"]
# action = "keep"                  # keep | pseudonymize | block
