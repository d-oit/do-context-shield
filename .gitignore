# Rust build artifacts
/target/
# The detached cargo-fuzz workspace builds into its own target directory;
# `fuzz/Cargo.lock` is committed (like the root lockfile) for reproducibility.
/fuzz/target/
# Fuzzer-written coverage/build scratch and crashing reproducers: CI uploads
# the artifacts, minimized seeds live under `fuzz/corpus/`.
/fuzz/coverage/
/fuzz/artifacts/

# do-harness local state and evidence artifacts
.do-harness/
# `do-harness task export` snapshot, derived from the state database above
# (`do-harness task list` reads the live state; this file is never hand-edited)
/plans/tasks.json

# Local model exports and ONNX Runtime archives (paths docs/plugins.md creates
# inside the checkout; they are hundreds of megabytes and never committed)
/models/
/ort.tgz
/onnxruntime-*/

# Cargo.lock is committed for this repo because it ships a binary (CLI).
# Do not ignore it.

# Generated documentation
/doc/

# IDE and editor files
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
.vscode/
.cursor/
.cursorrules

# Coverage reports
lcov.info
coverage/
*.profraw
*.profdata

# Environment files
.env
.env.local
.env.*.local
*.local

# Reports and profiling
flamegraph.svg
perf.data
perf.data.old
criterion/

# Temporary files
*.tmp
*.bak
*.orig
*.log

# Python helpers
__pycache__/
*.pyc

# Node.js (docs tooling)
node_modules/
